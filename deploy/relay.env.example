RUFREN_RELAY_BIND=127.0.0.1:8787
RUFREN_RELAY_DB=/var/lib/rufren/relay.sqlite
RUFREN_RELAY_ASSETS=/var/lib/rufren/assets
RUFREN_RELAY_ASSET_QUOTA_BYTES=536870912
# Exact app origin(s), comma separated, without trailing slash; CORS is not authentication.
RUFREN_ALLOWED_ORIGINS=https://russian.example.invalid
# Generate locally and write directly to /etc/rufren/relay.env; never commit the real key.
RUFREN_SYNC_TOKEN=
# AI tutoring stays disabled unless explicitly selected and given a server-side API key.
RUFREN_TUTOR_PROVIDER=disabled
