{
  "version": 1,
  "constructions": [
    {"id": "gender", "name": "мой · моя · моё", "note": "Words agree with a noun's gender: masculine (consonant), feminine (-а/-я), neuter (-о/-е)."},
    {"id": "plural", "name": "plural -ы -и -а", "note": "Nouns make their plural with -ы/-и (-а for some neuters).", "requires": ["gender"]},
    {"id": "negation", "name": "не + verb", "note": "не goes right before what it negates."},
    {"id": "inf", "name": "infinitive -ть", "note": "The dictionary form of a verb: читать, говорить."},
    {"id": "pres-1sg", "name": "я -ю / -у", "note": "Present tense, I: читаю, говорю, иду.", "requires": ["inf"]},
    {"id": "pres-2sg", "name": "ты -ешь / -ишь", "note": "Present tense, you (one person): читаешь, говоришь.", "requires": ["pres-1sg"]},
    {"id": "pres-3sg", "name": "он, она -ет / -ит", "note": "Present tense, he/she/it: читает, говорит.", "requires": ["pres-1sg"]},
    {"id": "pres-1pl", "name": "мы -ем / -им", "note": "Present tense, we: читаем, говорим.", "requires": ["pres-3sg"]},
    {"id": "pres-2pl", "name": "вы -ете / -ите", "note": "Present tense, you (several, or polite): читаете, говорите.", "requires": ["pres-2sg"]},
    {"id": "pres-3pl", "name": "они -ют / -ят", "note": "Present tense, they: читают, говорят.", "requires": ["pres-3sg"]},
    {"id": "past", "name": "past -л -ла -ло -ли", "note": "Past tense: the stem plus -л, agreeing with the subject's gender or plural.", "requires": ["inf", "gender"]},
    {"id": "acc-u", "name": "accusative -у / -ю", "note": "A feminine object: книга → книгу, Земля → Землю.", "requires": ["gender"]},
    {"id": "acc-dir", "name": "в / на + where to", "note": "Going somewhere takes the accusative: в город, на работу.", "requires": ["acc-u"]},
    {"id": "prep-e", "name": "в / на + -е", "note": "Where something is: в доме, на столе, на кухне.", "requires": ["gender"]},
    {"id": "time-instr", "name": "утром · вечером", "note": "Times of day as instrumental: утром, днём, вечером, ночью."},
    {"id": "have", "name": "у меня есть", "note": "Having: “at me there is”."},
    {"id": "genitive", "name": "genitive", "note": "Of, for, after numbers: двух чисел, для любого числа.", "requires": ["gender"]}
  ],
