{
 "version": 1,
 "contrasts": [
  {
   "id": "y-i",
   "name": "ы or и",
   "note": "For ы, keep your lips spread as for и but pull the whole tongue back. A hard consonant comes before ы, a soft one before и."
  },
  {
   "id": "hard-soft",
   "name": "Hard or soft",
   "note": "A soft consonant is said with the middle of the tongue raised toward the roof of the mouth, at the same moment as the consonant. ь, я, ё, ю, е and и mark it; it is not an extra syllable."
  },
  {
   "id": "sh-shch",
   "name": "ш or щ",
   "note": "ш is hard and low, tongue cupped back. щ is long and soft, tongue raised and forward, like a drawn-out sh in “sheep”."
  },
  {
   "id": "zh-sh",
   "name": "ж or ш",
   "note": "ж is ш with the voice on. At the end of a word the voice goes off: луг and лук sound the same, and so do код and кот."
  },
  {
   "id": "reduction",
   "name": "Unstressed о",
   "note": "Only a stressed о sounds like о. Before the stress it sounds like а: дома́ is said “дама́”."
  },
  {
   "id": "stress",
   "name": "Where the stress falls",
   "note": "The stressed vowel is longer and clearer; the others shrink. Moving it makes a different word."
  }
 ],
